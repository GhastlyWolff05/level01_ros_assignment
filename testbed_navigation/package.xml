<?xml-model
href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"
?>
<package format="3">
<name>testbed_navigation</name>
<version>0.0.0</version>
<description>
Manual Nav2 bringup (map_server, AMCL, planner, controller, BT) for the Testbed-T1.0.0 robot.
</description>
<maintainer email="shawrohanta@gmail.com">RoS</maintainer>
<license>Apache-2.0</license>
<buildtool_depend>ament_cmake</buildtool_depend>
<!-- Nav2 pieces we be drivin in the launch files -->
<exec_depend>nav2_map_server</exec_depend>
<exec_depend>nav2_amcl</exec_depend>
<exec_depend>nav2_planner</exec_depend>
<exec_depend>nav2_controller</exec_depend>
<exec_depend>nav2_behaviors</exec_depend>
<exec_depend>nav2_bt_navigator</exec_depend>
<exec_depend>nav2_velocity_smoother</exec_depend>
<exec_depend>nav2_lifecycle_manager</exec_depend>
<!-- The map/robot live in these packages -->
<exec_depend>testbed_bringup</exec_depend>
<exec_depend>testbed_description</exec_depend>
<exec_depend>testbed_gazebo</exec_depend>
<exec_depend>launch</exec_depend>
<exec_depend>launch_ros</exec_depend>
<test_depend>ament_lint_auto</test_depend>
<test_depend>ament_lint_common</test_depend>
<export>
<build_type>ament_cmake</build_type>
</export>
</package>